<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Fintech Veri Yönetim Sistemi</h1>
        <p class="text-muted">Lütfen erişmek istediğiniz paneli seçiniz.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- ADMIN PANELİ KARTI -->
        <div class="col-md-5">
            <div class="card shadow-sm border-primary h-100 p-4 text-center">
                <i class="bi bi-shield-lock display-4 text-primary mb-3"></i>
                <h4>Admin Paneli</h4>
                <p class="small text-muted mb-4">Tüm firma finansal verileri, AI analiz süreçleri ve uzman görüşü yönetimi.</p>
                <a asp-controller="Companies" asp-action="Create" class="btn btn-primary fw-bold py-2">
                    Yönetime Git
                </a>
            </div>
        </div>

        <!-- KULLANICI PANELİ KARTI -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100 p-4 text-center">
                <i class="bi bi-person-workspace display-4 text-secondary mb-3"></i>
                <h4>Kullanıcı Paneli</h4>
                <p class="small text-muted mb-4">Sözleşmeli şirket verilerini görüntüleme ve finansal rapor takibi.</p>
                <a href="#" class="btn btn-outline-secondary py-2 disabled">Yakında (Modül Hazırlanıyor)</a>
            </div>
        </div>
    </div>
</div>